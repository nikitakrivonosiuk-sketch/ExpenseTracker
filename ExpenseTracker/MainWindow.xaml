<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExpenseTracker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" 
                    Margin="0,0,10,0">
            
            <TextBlock Text="Сума:" 
                       Margin="0,0,0,5"/>
            
            <TextBox x:Name="AmountInput" 
                     TextChanged="TextBox_TextChanged" 
                     Margin="0,0,0,10"/>

            <TextBlock Text="Категорія:" 
                       Margin="0,0,0,5"/>
            
            <ComboBox x:Name="categoryComboBox" 
                      Margin="0,0,0,10"/>

            <Button x:Name="AddButton" 
                    Content="Додати" 
                    Click="Button_Click" 
                    IsEnabled="False" 
                    Margin="0,0,0,10" 
                    Height="30"/>
            
            <Button x:Name="EditButton" 
                    Content="Редагувати вибране" 
                    Click="Button_Edit_Click" 
                    Margin="0,0,0,10" 
                    Height="30"/>
            
            <Button x:Name="DeleteButton" 
                    Content="Видалити вибране" 
                    Click="Button_Delete_Click" 
                    Margin="0,0,0,10" 
                    Height="30"/>

            <Button Content="Очистити всю базу" 
                    Click="Button_Clear" 
                    Margin="0,0,0,10" 
                    Height="30"/>

            <TextBlock Text="Загалом витрачено:" 
                       Margin="0,20,0,5" 
                       FontWeight="Bold"/>
            
            <TextBlock x:Name="TotalSpentText" 
                       Text="0 $" FontSize="16" 
                       Foreground="Blue" 
                       FontWeight="Bold"/>
        </StackPanel>

        <DataGrid x:Name="ExpensesList" 
                  Grid.Column="1" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  SelectionMode="Single"/>
    </Grid>
</Window>
